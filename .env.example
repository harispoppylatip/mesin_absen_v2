# Pengaturan layanan wajah InsightFace untuk aplikasi absen solat.
#
# Salin berkas ini menjadi `.env` bila ingin mengubah bawaannya.
# Semua kunci di bawah punya nilai bawaan di app.py, jadi layanan tetap jalan
# tanpa berkas .env sama sekali.

# ---------------------------------------------------------------- jaringan
# PENTING: dua baris ini HANYA dibaca oleh app.py bila layanan dijalankan
# langsung dengan Python. app.py membaca variabel lingkungan, BUKAN berkas
# .env ini, jadi di luar Docker kuncinya diisi lewat terminal, mis.
#     $env:FACE_HOST="0.0.0.0"; python app.py
#
# Di dalam Docker dua baris ini SAMA SEKALI TIDAK BERPENGARUH: Dockerfile
# sudah memasang FACE_HOST=0.0.0.0 di dalam kontainer (sehingga kontainer
# mendengarkan semua antarmuka), dan yang menentukan apakah port 5005 bisa
# dibuka dari komputer lain adalah FACE_PUBLISH_HOST di bagian "Docker" di
# bawah berkas ini, BUKAN FACE_HOST.
#
# 127.0.0.1 hanya menerima koneksi dari komputer yang sama. Layanan ini tidak
# punya kata sandi, jadi membukanya ke jaringan harus keputusan sadar.
FACE_HOST=127.0.0.1
FACE_PORT=5005

# -------------------------------------------------------------------- model
# buffalo_sc = det_500m + MobileFaceNet, ringan dan cepat.
# buffalo_l  = det_10g + ResNet50, lebih tahan sudut sulit tapi sekitar 8 kali
#              lebih berat saat menghitung angka wajah.
FACE_MODEL=buffalo_sc

# Folder tempat model disimpan dan diunduh. Bila kosong, diisi otomatis ke
# folder `cache/models` di sebelah app.py.
# FACE_MODEL_ROOT=./cache/models

# Nama model yang dilaporkan ke aplikasi sekolah. WAJIB sama dengan FACE_MODEL
# di .env aplikasi Laravel. Bila berbeda, aplikasi menolak angkanya dengan
# sengaja supaya wajah lama tidak dicampur dengan wajah model baru.
FACE_MODEL_NAME=insightface-buffalo_sc

# Dimensi angka wajah. WAJIB sama dengan FACE_EMBEDDING_DIMENSIONS di .env
# aplikasi Laravel. InsightFace ArcFace memakai 512.
FACE_DIMENSIONS=512

# Kartu grafis NVIDIA. Perlu onnxruntime-gpu dan NVIDIA Container Toolkit.
FACE_USE_GPU=0
# FACE_GPU_DEVICE_ID=0

# ------------------------------------------------------------------ deteksi
# Ambang keyakinan detektor. Kecilkan bila wajah samar sering terlewat.
FACE_DET_THRESHOLD=0.5

# Sisi panjang kanvas detektor. Ini tombol paling besar pengaruhnya terhadap
# waktu proses. Terukur pada i7-13620H, gambar 1280x720, median lima kali:
#     sisi 640 -> 8,1 ms
#     sisi 320 -> 2,5 ms
# Turun ke 320 menghemat sekitar tiga kali waktu, dengan risiko wajah kecil
# atau orang yang jauh dari kamera tidak terbaca. Ukur dulu dengan
# `python verifikasi.py --benchmark` sebelum menurunkannya.
FACE_DETECT_LONG_SIDE=640

# Kanvas detektor mengikuti rasio gambar, sehingga tidak penuh padding nol.
# Terukur hampir dua kali lebih cepat pada gambar 1280x720 karena kanvas
# 640x640 hanya terisi 640x360.
FACE_DETECT_MATCH_ASPECT=1

# Paling banyak wajah yang dihitung angka wajahnya dalam satu gambar. Isi 0
# untuk tidak membatasi. Delapan sudah jauh melebihi jumlah orang yang masuk
# akal berada dalam satu bingkai kamera absen.
FACE_MAX_FACES=8

# Wajah yang sisi terpendeknya di bawah angka ini tidak dihitung angka
# wajahnya. Hanya pengaman CPU; aplikasi sekolah memakai batasnya sendiri
# (FACE_MIN_FACE_SIZE) untuk memutuskan.
FACE_EMBED_MIN_FACE_SIZE=24

# Batas jumlah piksel gambar yang diterima. 40 megapiksel sudah melebihi
# kamera ponsel mana pun; di atas itu kiriman ditolak supaya satu permintaan
# tidak menghabiskan memori server.
FACE_MAX_IMAGE_PIXELS=40000000

# ------------------------------------------------------------------- thread
# Terlalu banyak thread JUSTRU lebih lambat pada CPU dengan P-core dan E-core
# bercampur seperti i7-13620H. Empat intra, satu inter, dan satu OpenCV adalah
# titik aman. Benchmark di server sendiri sebelum mengubahnya.
FACE_ORT_INTRA_THREADS=4
FACE_ORT_INTER_THREADS=1
FACE_OPENCV_THREADS=1

# -------------------------------------------------------------- foto bukti
# Seluruh bingkai diperkecil menjadi JPEG kecil sebagai bukti absen.
FACE_PROOF_MAX_SIDE=480
FACE_PROOF_QUALITY=72
# Batas ukuran berkas bukti dalam kilobita. Mutu JPEG diturunkan bertahap
# sampai masuk batas ini.
FACE_PROOF_MAX_KB=48

# ----------------------------------------------------------------- perawatan
# Jalankan deteksi sekali saat mulai, supaya biaya penyiapan pustaka tidak
# ditanggung pengguna pertama.
FACE_WARMUP=1

# DEBUG, INFO, WARNING
FACE_LOG_LEVEL=INFO

# -------------------------------------------------------------------- Docker
# Kunci di bawah ini HANYA dibaca oleh `docker compose`, bukan oleh app.py.
# Tulis namanya tanpa tanda # di depan untuk memakainya.
#
# FACE_PUBLISH_HOST menentukan dari alamat mana port 5005 bisa dihubungi.
#     127.0.0.1  (bawaan) -> hanya dari komputer tempat Docker berjalan.
#                             Inilah yang diperlukan bila aplikasi Laravel
#                             dijalankan langsung dengan `php artisan serve`,
#                             sebab FACE_SERVICE_URL-nya menunjuk 127.0.0.1:5005.
#     0.0.0.0             -> bisa dibuka dari komputer lain lewat ip server,
#                             mis. http://192.168.1.10:5005/health
#
# PERHATIAN: layanan ini tidak punya kata sandi, jadi FACE_PUBLISH_HOST=0.0.0.0
# berarti siapa pun yang bisa menjangkau port itu boleh memakainya. Pakai
# hanya di jaringan sekolah yang tepercaya, dan pastikan port 5005 diizinkan
# di firewall server (Windows Firewall atau firewall bawaan Linux).
#
# Bila aplikasi Laravel juga berjalan sebagai kontainer, kunci ini tidak perlu
# diubah sama sekali: keduanya sudah bertemu lewat jaringan bersama
# absen-jaringan dan aplikasi memakai alamat http://wajah:5005.
#
# FACE_PUBLISH_HOST=0.0.0.0
# FACE_PUBLISH_PORT=5005

# Batas sumber daya wadah. Sesuaikan dengan server: pada mesin dua core setel
# FACE_CPUS=2 dan FACE_ORT_INTRA_THREADS=2 di bagian atas berkas ini.
# FACE_MEMORY_LIMIT=768m
# FACE_CPUS=4.0
